# /etc/signin/app.env, made by install.sh. Shown here only so you know what is in it.
NODE_ENV=production
HOST=127.0.0.1
PORT=3900
TRUSTED_PROXY=loopback
SIGNIN_ORIGIN=https://signin.example.co.uk
# The parent domain every app sits under, so one cookie covers them all.
COOKIE_DOMAIN=example.co.uk
APPS_FILE=/etc/signin/apps.json
DATABASE_URL=postgresql://rule29_signin_app:REPLACE_PASSWORD@127.0.0.1:5432/rule29_signin
# One random key per app (at least 32 characters). The same key goes in that app's SIGNIN_KEY.
SIGNIN_KEY_MIS=REPLACE
SIGNIN_KEY_QUOTING=REPLACE
SIGNIN_KEY_SCHEDULING=REPLACE
SIGNIN_KEY_TIMESHEETS=REPLACE
